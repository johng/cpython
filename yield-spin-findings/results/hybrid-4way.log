diff --git a/Include/internal/pycore_lock.h b/Include/internal/pycore_lock.h
index e31d8b4..3f7c9bd 100644
--- a/Include/internal/pycore_lock.h
+++ b/Include/internal/pycore_lock.h
@@ -73,6 +73,20 @@ extern int _PyMutex_TryUnlock(PyMutex *m);
 // Yield the processor to other threads (e.g., sched_yield).
 extern void _Py_yield(void);
 
+// Lightweight CPU pause hint (spin-wait) for the backoff phase of the mutex
+// spin: x86 PAUSE, ARM/AArch64 YIELD, else a compiler barrier.
+static inline void
+_Py_cpu_relax(void)
+{
+#if defined(__x86_64__) || defined(__i386__)
+    __asm__ volatile ("pause" ::: "memory");
+#elif defined(__aarch64__) || (defined(__arm__) && __ARM_ARCH >= 7)
+    __asm__ volatile ("yield" ::: "memory");
+#else
+    __asm__ volatile ("" ::: "memory");
+#endif
+}
+
 
 // PyEvent is a one-time event notification
 typedef struct {
diff --git a/Python/lock.c b/Python/lock.c
index ad97bfd..a630a58 100644
--- a/Python/lock.c
+++ b/Python/lock.c
@@ -31,6 +31,12 @@ static const int MAX_SPIN_COUNT = 40;
 static const int MAX_SPIN_COUNT = 0;
 #endif
 
+// Backoff schedule for the spin phase: spend the first PAUSE_SPINS iterations
+// on a cheap CPU pause (exponentially growing up to PAUSE_BACKOFF_CAP pauses)
+// before escalating to a scheduler yield.
+static const int PAUSE_SPINS = 8;
+static const int PAUSE_BACKOFF_CAP = 64;
+
 struct mutex_entry {
     // The time after which the unlocking thread should hand off lock ownership
     // directly to the waiting thread. Written by the waiting thread.
@@ -79,6 +85,7 @@ _PyMutex_LockTimed(PyMutex *m, PyTime_t timeout, _PyLockFlags flags)
     };
 
     Py_ssize_t spin_count = 0;
+    int backoff = 1;
     for (;;) {
         if ((v & _Py_LOCKED) == 0) {
             // The lock is unlocked. Try to grab it.
@@ -89,9 +96,23 @@ _PyMutex_LockTimed(PyMutex *m, PyTime_t timeout, _PyLockFlags flags)
         }
 
         if (!(v & _Py_HAS_PARKED) && spin_count < MAX_SPIN_COUNT) {
-            // Spin for a bit.
-            _Py_yield();
+            // Adaptive backoff: cheap CPU pause (exponential, to cut cache-line
+            // traffic) for the first PAUSE_SPINS iterations, then escalate to a
+            // scheduler yield so the lock holder can run if it needs this core.
+            // Reload each turn so an early release is grabbed without parking.
+            if (spin_count < PAUSE_SPINS) {
+                for (int i = 0; i < backoff; i++) {
+                    _Py_cpu_relax();
+                }
+                if (backoff < PAUSE_BACKOFF_CAP) {
+                    backoff <<= 1;
+                }
+            }
+            else {
+                _Py_yield();
+            }
             spin_count++;
+            v = _Py_atomic_load_uint8_relaxed(&m->_bits);
             continue;
         }
 
